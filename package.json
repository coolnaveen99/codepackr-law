{
  "name": "codepackr-law",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "sitemap": "npx tsx scripts/generate_sitemap.ts",
    "indexnow": "npx tsx scripts/submit_indexnow.ts",
    "build": "node scripts/restore-topic-detail.mjs && tsc --noEmit && npx tsx scripts/generate_sitemap.ts && vite build && node scripts/prerender.mjs",
    "lint": "node scripts/restore-topic-detail.mjs && tsc --noEmit",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "checklist": "npx tsx scripts/generate_checklist.ts",
    "audit": "npx tsx scripts/audit_subjects.ts",
    "validate:topics": "npx tsx scripts/validate_topics.ts",
    "validate:judgments": "npx tsx scripts/validate_judgments.ts",
    "validate:content": "npx tsx scripts/validate_content.ts",
    "test": "npx tsx --test tests/*.test.ts",
    "test:run": "npx tsx --test tests/*.test.ts",
    "parity:legal-content": "node scripts/parity-legal-content.mjs",
    "audit:legal-content": "npx tsx scripts/audit_legal_content_integrity.ts",
    "check:canonical-delivery": "node scripts/check-canonical-delivery.mjs",
    "check:readiness": "node scripts/pr-readiness.mjs",
    "inventory:cm-001": "node scripts/cm-001-gap.mjs",
    "check:cm-migration": "node scripts/cm-migration-gate.mjs",
    "check:production-integration": "node scripts/check-production-integration.mjs"
  },
  "dependencies": {
    "docx": "^9.5.1",
    "file-saver": "^2.0.5",
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
