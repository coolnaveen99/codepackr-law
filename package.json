{
  "name": "codepackr-law",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "sitemap": "npx tsx scripts/generate_sitemap.ts",
    "indexnow": "npx tsx scripts/submit_indexnow.ts",
    "build": "tsc --noEmit && npx tsx scripts/generate_sitemap.ts && vite build && node scripts/prerender.mjs",
    "lint": "tsc --noEmit",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "checklist": "npx tsx scripts/generate_checklist.ts",
    "audit": "npx tsx scripts/audit_subjects.ts",
    "validate:topics": "npx tsx scripts/validate_topics.ts",
    "validate:judgments": "npx tsx scripts/validate_judgments.ts",
    "test": "npx tsx --test tests/unit.test.ts",
    "test:run": "npx tsx --test tests/unit.test.ts"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "docx": "^9.5.1",
    "file-saver": "^2.0.5",
    "jspdf": "^3.0.2",
    "mammoth": "^1.11.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
